# ==============================================================================
# 🔐 TEMPLATE ENVIRONMENT VARIABLES (ISI SESUAI MILIK ANDA SENDIRI)
# ==============================================================================
# File ini adalah template publik untuk GitHub. 
# JANGAN PERNAH memasukkan kunci API / kredensial asli ke file ini atau push ke Git!
#
# PANDUAN PENGGUNAAN:
# 1. Salin file ini menjadi `.env` di komputer lokal Anda:
#    cp .env.example .env
# 2. Isi nilai-nilai di bawah ini dengan kredensial milik Anda sendiri:

# --- 1. Kredensial Supabase (Wajib jika ingin sinkronisasi multi-device) ---
# Dapatkan dari Supabase Dashboard -> Project Settings -> Configuration -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- 2. PIN Kasir Kustom (Opsional - default: 1234) ---
# Ubah jika ingin menggunakan 4 digit PIN kasir rahasia sendiri
VITE_CASHIER_PIN=1234

# --- 3. Token WhatsApp Bot Fonnte (Opsional) ---
# Dapatkan token perangkat dari https://fonnte.com untuk notifikasi WA otomatis
# Biarkan kosong jika tidak mengaktifkan fitur bot WhatsApp
VITE_FONNTE_TOKEN=your-fonnte-token-here
